# ---------- database ----------
DATABASE_URL=postgresql://docs_mcp:docs_mcp@localhost:5432/docs_mcp

# ---------- embeddings (local via HuggingFace) ----------
EMBEDDING_PROVIDER=local            # local | hash   (hash = fake vectors, tests/dev only)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_MAX_TOKENS=1024
LOCAL_EMBEDDING_DEVICE=auto         # auto | cuda | cpu

# ---------- LLM (chat answers — any OpenAI-compatible provider) ----------
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=2048
# --- switching providers = change base URL + model (+ key) ---
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-3.6-flash
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=google/gemma-4-31b-it:free
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
# Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1         LLM_MODEL=claude-sonnet-4-5

# ---------- crawler ----------
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=30
CRAWL_DELAY=0.5
USER_AGENT=docs-mcp-bot/0.1 (documentation indexer)

# ---------- servers ----------
MCP_TRANSPORT=stdio
API_HOST=127.0.0.1
API_PORT=8000
CRAWL_CACHE_DIR=.crawl-cache
