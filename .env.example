# ---------- database ----------
DATABASE_URL=postgresql://docs_mcp:docs_mcp@localhost:5432/docs_mcp

# ---------- embeddings ----------
# Provider: "local" (HuggingFace, needs ~4GB RAM) or "api" (any OpenAI-compatible API)
EMBEDDING_PROVIDER=local

# API provider config (when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMS=1024
# --- free embedding APIs ---
# Jina:   EMBEDDING_BASE_URL=https://api.jina.ai/v1   EMBEDDING_MODEL=jina-embeddings-v3   EMBEDDING_DIMS=1024
# OpenAI: EMBEDDING_BASE_URL=https://api.openai.com/v1 EMBEDDING_MODEL=text-embedding-3-small EMBEDDING_DIMS=1536

# Local provider config (when EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_MAX_TOKENS=1024
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_MIN_FREE_VRAM_GIB=4

# ---------- LLM (chat answers — any OpenAI-compatible provider) ----------
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=2048

# ---------- crawler ----------
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=30
CRAWL_DELAY=0.5
USER_AGENT=fathom-mcp/0.1 (documentation indexer)

# ---------- servers ----------
MCP_TRANSPORT=stdio
API_HOST=0.0.0.0
API_PORT=8000
CRAWL_CACHE_DIR=.crawl-cache
